---
import Icon from '@components/ui/Icon.astro';
import { SITE_CONFIG } from '@config/site';
import { formatTelHref } from '@lib/contact';

interface Props {
  variant?: 'pill' | 'block' | 'compact' | 'ghost';
  showLabel?: boolean;
  prefixText?: string;
  class?: string;
  iconName?: string;
}

const {
  variant = 'pill',
  showLabel = true,
  prefixText = 'Call Now',
  class: className,
  iconName = 'call'
} = Astro.props;

const href = formatTelHref(SITE_CONFIG.phoneDisplay);
---

<a
  href={href}
  class:list={['phone-link', `phone-link--${variant}`, className]}
  aria-label={`Call AutoLock Pro USA dispatch at ${SITE_CONFIG.phoneDisplay}`}
>
  <span class="phone-link__icon-wrap">
    <Icon name={iconName} size={variant === 'compact' ? 16 : 20} class="phone-link__icon" />
  </span>
  {showLabel && (
    <span class="phone-link__content">
      {prefixText && <span class="phone-link__prefix">{prefixText}:</span>}
      <span class="phone-link__number">{SITE_CONFIG.phoneDisplay}</span>
    </span>
  )}
</a>

<style>
  .phone-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast),
      box-shadow var(--transition-fast);
    min-height: 44px;
    -webkit-tap-highlight-color: transparent;
  }

  .phone-link:active {
    transform: scale(0.97);
  }

  /* Pill Variant: Primary Header & CTA */
  .phone-link--pill {
    background-color: var(--color-emergency-container);
    color: var(--color-on-emergency);
    border-radius: var(--radius-full);
    padding: 0.65rem 1.35rem;
    font-size: var(--text-label-md);
    box-shadow: var(--shadow-emergency);
  }

  .phone-link--pill:hover {
    background-color: var(--color-emergency-hover);
    box-shadow: 0 10px 28px -4px rgba(249, 115, 22, 0.45);
  }

  /* Block Variant: Full width on hero and banners */
  .phone-link--block {
    display: flex;
    width: 100%;
    background-color: var(--color-emergency-container);
    color: var(--color-on-emergency);
    border-radius: var(--radius-2xl);
    padding: 0.875rem 1.5rem;
    font-size: var(--text-label-lg);
    box-shadow: var(--shadow-emergency);
  }

  .phone-link--block:hover {
    background-color: var(--color-emergency-hover);
  }

  /* Compact Variant: Header pill on small mobile viewports */
  .phone-link--compact {
    background-color: var(--color-emergency-container);
    color: var(--color-on-emergency);
    border-radius: var(--radius-full);
    padding: 0.4rem 0.85rem;
    font-size: var(--text-label-sm);
    min-height: 36px;
  }

  /* Ghost Variant: Transparent / text link */
  .phone-link--ghost {
    background-color: transparent;
    color: var(--color-primary-container);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-label-md);
  }

  .phone-link--ghost:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .phone-link__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .phone-link__prefix {
    margin-right: 0.25rem;
    opacity: 0.95;
  }

  .phone-link__number {
    letter-spacing: -0.01em;
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-link {
      transition: none;
      transform: none;
    }
  }
</style>
