---
interface Props {
  variant?: 'primary' | 'emergency' | 'success' | 'surface' | 'slate';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'primary', size = 'sm', class: className } = Astro.props;
---

<span class:list={['ui-badge', `ui-badge--${variant}`, `ui-badge--${size}`, className]}>
  <slot />
</span>

<style>
  .ui-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    border-radius: var(--radius-full);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .ui-badge--sm {
    font-size: var(--text-label-sm);
    padding: 0.25rem 0.625rem;
  }

  .ui-badge--md {
    font-size: var(--text-label-md);
    padding: 0.35rem 0.75rem;
  }

  .ui-badge--primary {
    background: var(--color-primary-fixed);
    color: var(--color-primary);
  }

  .ui-badge--emergency {
    background: #ffedd5;
    color: #c2410c;
  }

  .ui-badge--success {
    background: var(--color-success-container);
    color: var(--color-on-success);
  }

  .ui-badge--surface {
    background: var(--color-surface-container);
    color: var(--color-ink);
  }

  .ui-badge--slate {
    background: var(--color-surface-dim);
    color: var(--color-ink-muted);
  }
</style>
