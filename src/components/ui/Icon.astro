---
import icons from '@iconify-json/material-symbols/icons.json';
import { getIconData, iconToSVG } from '@iconify/utils';

interface Props {
  name: string;
  size?: number | string | undefined;
  class?: string | undefined;
  ariaLabel?: string | undefined;
}

const { name, size = 20, class: className, ariaLabel } = Astro.props;

// Self-hosted brand and custom vector icons not found in Material Symbols
const CUSTOM_ICONS: Record<string, { viewBox: string; body: string }> = {
  facebook: {
    viewBox: '0 0 24 24',
    body: '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>'
  }
};

// Normalizing icon name (e.g. 'phone_in_talk' or 'material-symbols:phone_in_talk' -> 'phone-in-talk')
const normalizedName = name.replace(/^material-symbols:/, '').replace(/_/g, '-');
const customIcon = CUSTOM_ICONS[name] ?? CUSTOM_ICONS[normalizedName];
const iconData = customIcon ? null : getIconData(icons, normalizedName);

if (!customIcon && !iconData) {
  console.warn(`Icon "${name}" not found in @iconify-json/material-symbols`);
}

const rendered = customIcon
  ? { attributes: { viewBox: customIcon.viewBox }, body: customIcon.body }
  : iconData
    ? iconToSVG(iconData)
    : null;
const isDecorative = !ariaLabel;
const pxSize = typeof size === 'number' ? `${size}px` : size;
---

{rendered ? (
  <svg
    viewBox={rendered.attributes.viewBox}
    width={pxSize}
    height={pxSize}
    class:list={['ui-icon', className]}
    aria-hidden={isDecorative ? 'true' : undefined}
    aria-label={ariaLabel}
    role={isDecorative ? undefined : 'img'}
    set:html={rendered.body}
  />
) : null}

<style>
  .ui-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    fill: currentColor;
  }
</style>
