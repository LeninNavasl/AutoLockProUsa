---
import { Image } from 'astro:assets';
import Badge from '@components/ui/Badge.astro';
import Icon from '@components/ui/Icon.astro';
import { SITE_CONFIG } from '@config/site';
import type { ServiceItem } from '@data/services';
import { formatTelHref } from '@lib/contact';

interface Props {
  service: ServiceItem;
  showImage?: boolean | undefined;
}

const { service, showImage = false } = Astro.props;
const telHref = formatTelHref(SITE_CONFIG.phoneDisplay);
---

<article class="service-card" id={service.id}>
  <!-- Card Header Row: Icon Well + Badge -->
  <div class="service-card__top">
    <div class:list={['service-card__icon-well', `service-card__icon-well--${service.iconBg}`]}>
      <Icon name={service.icon} size={26} />
    </div>
    <div class="service-card__badges">
      <Badge variant="surface" size="sm">
        {service.badge}
      </Badge>
      {service.subBadge && (
        <Badge variant="slate" size="sm">
          {service.subBadge}
        </Badge>
      )}
    </div>
  </div>

  <!-- Content Block -->
  <div class="service-card__content">
    <h3 class="service-card__title">{service.title}</h3>
    <p class="service-card__desc">{service.fullDesc || service.shortDesc}</p>
  </div>

  <!-- Optional Context Image -->
  {showImage && service.image && (
    <div class="service-card__media">
      <Image
        src={service.image}
        alt={service.imageAlt}
        width={640}
        height={360}
        class="service-card__img"
        loading="lazy"
      />
      {service.guaranteeText && (
        <div class="service-card__media-badge">
          <Icon name="verified" size={16} />
          <span>{service.guaranteeText}</span>
        </div>
      )}
    </div>
  )}

  <!-- Action Row -->
  <div class="service-card__action">
    <a
      href={telHref}
      class="service-card__call-link"
      aria-label={`Call to request ${service.title} at ${SITE_CONFIG.phoneDisplay}`}
    >
      <span>Call for tech availability</span>
      <Icon name="arrow_forward" size={16} class="service-card__arrow" />
    </a>
  </div>
</article>

<style>
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-md);
    box-shadow: var(--shadow-1);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .service-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .service-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .service-card__icon-well {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-xl);
    flex-shrink: 0;
  }

  .service-card__icon-well--primary {
    background: var(--color-primary-fixed);
    color: var(--color-primary);
  }

  .service-card__icon-well--emergency {
    background: #ffedd5;
    color: #c2410c;
  }

  .service-card__icon-well--success {
    background: var(--color-success-container);
    color: var(--color-success-dark);
  }

  .service-card__icon-well--surface {
    background: var(--color-surface-container);
    color: var(--color-primary-container);
  }

  .service-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
  }

  .service-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-card__title {
    font-size: var(--text-headline-sm);
    font-weight: 800;
    color: var(--color-ink);
    line-height: 1.25;
  }

  .service-card__desc {
    font-size: var(--text-body-sm);
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .service-card__media {
    position: relative;
    width: 100%;
    height: 11rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-top: var(--space-xs);
    background: var(--color-surface-container);
  }

  .service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .service-card:hover .service-card__img {
    transform: scale(1.02);
  }

  .service-card__media-badge {
    position: absolute;
    bottom: 0.5rem;
    left: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: var(--text-label-sm);
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .service-card__action {
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .service-card__call-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary-container);
    font-size: var(--text-label-md);
    font-weight: 700;
    text-decoration: none;
    transition:
      color var(--transition-fast),
      gap var(--transition-fast);
  }

  .service-card__call-link:hover {
    color: var(--color-primary);
    gap: 0.55rem;
  }

  .service-card__arrow {
    transition: transform var(--transition-fast);
  }

  .service-card__call-link:hover .service-card__arrow {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card__img,
    .service-card__call-link,
    .service-card__arrow {
      transition: none;
      transform: none;
    }
  }
</style>
