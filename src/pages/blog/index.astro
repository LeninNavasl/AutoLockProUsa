---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CtaBanner from '@components/sections/CtaBanner.astro';
import Badge from '@components/ui/Badge.astro';
import Icon from '@components/ui/Icon.astro';
import { SITE_CONFIG } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';

// Fetch non-draft posts
const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title={`Car Key & Locksmith Guides | ${SITE_CONFIG.name}`}
  description="Practical roadside advice, smart fob pairing guides, and vehicle security tips from licensed automotive locksmith technicians."
  currentPath="/blog/"
>
  <div class="blog-index">
    <div class="container">
      <!-- Section Header -->
      <section class="blog-index__header">
        <Badge variant="primary" size="md">
          <Icon name="menu_book" size={16} />
          <span>Technician Knowledge Base</span>
        </Badge>
        <h1 class="blog-index__title">Helpful Car Key Guides & Tips</h1>
        <p class="blog-index__subtitle">
          Practical roadside advice and vehicle security tips from licensed automotive technicians.
        </p>

        <!-- Category Filters -->
        <div
          class="blog-index__filters"
          id="category-filter-bar"
          role="toolbar"
          aria-label="Filter blog posts by topic"
        >
          <button
            type="button"
            class="filter-pill filter-pill--active"
            data-category="all"
            aria-pressed="true"
          >
            All Guides
          </button>
          <button
            type="button"
            class="filter-pill"
            data-category="replacement"
            aria-pressed="false"
          >
            Key Replacement
          </button>
          <button type="button" class="filter-pill" data-category="fobs" aria-pressed="false">
            Smart Fobs
          </button>
          <button type="button" class="filter-pill" data-category="emergency" aria-pressed="false">
            Emergency Tips
          </button>
        </div>
      </section>

      <!-- Article Cards Stack -->
      <section class="blog-index__articles" id="articles-container" aria-label="Articles list">
        {posts.map((post) => (
          <article class="article-card" data-category={post.data.category}>
            <!-- Media -->
            <div class="article-card__media">
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt}
                width={640}
                height={360}
                class="article-card__img"
                loading="lazy"
              />
              <div class="article-card__badge-wrap">
                <Badge variant={post.data.badgeTone} size="sm">
                  {post.data.badge}
                </Badge>
              </div>
            </div>

            <!-- Content -->
            <div class="article-card__content">
              <div class="article-card__meta">
                <span class="article-card__meta-item">
                  <Icon name="schedule" size={15} />
                  <span>{post.data.readingMinutes} min read</span>
                </span>
                <span class="article-card__meta-sep">•</span>
                <span>{post.data.publishDate}</span>
              </div>

              <h2 class="article-card__title">
                <a href={`/blog/${post.id}/`} class="article-card__title-link">
                  {post.data.title}
                </a>
              </h2>

              <p class="article-card__desc">{post.data.description}</p>

              <div class="article-card__footer">
                <a href={`/blog/${post.id}/`} class="article-card__read-link">
                  <span>Read Guide</span>
                  <Icon name="arrow_forward" size={16} />
                </a>
              </div>
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>

  <!-- Emergency Dispatch CTA -->
  <CtaBanner
    title="Locked out or need emergency key cutting now?"
    subtitle="Mobile diagnostic vans stationed nationwide equipped with computerized CNC code cutters and dealer-level programmers."
  />

  <!-- Progressive Filter Script -->
  <script src="../../scripts/blog-filter.ts"></script>
</BaseLayout>

<style>
  .blog-index {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-2xl);
  }

  .blog-index__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    max-width: 44rem;
    margin-bottom: var(--space-xl);
  }

  .blog-index__title {
    font-size: var(--text-headline-lg);
    font-weight: 800;
    color: var(--color-ink);
    margin-top: 0.25rem;
  }

  .blog-index__subtitle {
    font-size: var(--text-body-md);
    color: var(--color-ink-muted);
  }

  /* Filter Pills */
  .blog-index__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
  }

  .filter-pill {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: var(--text-label-md);
    font-weight: 600;
    background: var(--color-surface-container);
    color: var(--color-ink-muted);
    border: 1px solid transparent;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    color: var(--color-ink);
    background: var(--color-surface-container-high);
  }

  .filter-pill--active {
    background: var(--color-primary) !important;
    color: var(--color-on-primary) !important;
    box-shadow: var(--shadow-sm);
  }

  /* Articles Stack */
  .blog-index__articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 48rem;
  }

  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .article-card__media {
    position: relative;
    width: 100%;
    height: 12rem;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--color-surface-container);
  }

  .article-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .article-card:hover .article-card__img {
    transform: scale(1.02);
  }

  .article-card__badge-wrap {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .article-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-label-sm);
    color: var(--color-ink-muted);
  }

  .article-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .article-card__meta-sep {
    opacity: 0.5;
  }

  .article-card__title {
    font-size: var(--text-headline-sm);
    font-weight: 800;
    line-height: 1.3;
  }

  .article-card__title-link {
    color: var(--color-ink);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-card__title-link:hover {
    color: var(--color-primary);
  }

  .article-card__desc {
    font-size: var(--text-body-sm);
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  .article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .article-card__read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary-container);
    font-size: var(--text-label-md);
    font-weight: 700;
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .article-card__read-link:hover {
    gap: 0.55rem;
  }

  @media (min-width: 44rem) {
    .article-card {
      flex-direction: row;
      align-items: center;
    }

    .article-card__media {
      width: 16rem;
      height: 11rem;
      flex-shrink: 0;
    }

    .article-card__content {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card__img,
    .article-card__read-link {
      transition: none;
      transform: none;
    }
  }
</style>
